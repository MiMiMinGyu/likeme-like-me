# ===================================================================
# apps/web 환경변수 템플릿 (Vite)
# ===================================================================
# Vite 는 `VITE_` 접두사가 붙은 값만 클라이언트 번들에 노출한다.
# 여기 들어가는 값은 전부 빌드 결과물에 그대로 박히므로 비밀값을 두지 말 것.
#
# 로딩 규칙 (Vite 네이티브):
#   .env                 항상 로드
#   .env.development     `vite` (dev 서버) 실행 시
#   .env.production      `vite build` 시
#   .env.example         템플릿 (로드 안 됨) — 이 파일
#
# .env.development / .env.production 은 비밀이 아니므로 저장소에 커밋된다.

# API 서버 베이스 URL.
#   dev  : http://localhost:3000  (Vite dev 서버는 별도 포트라 절대 URL 필요)
#   prod : 빈 값  → 상대 경로 요청 → 같은 오리진의 Caddy 가 api 로 프록시
VITE_API_BASE_URL=http://localhost:3000
