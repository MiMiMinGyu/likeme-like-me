# ===================================================================
# 환경 변수 템플릿
# ===================================================================
# 이 파일을 복사하여 .env 파일을 만들고 실제 값으로 채우세요.
#   cp .env.example .env
# .env 는 절대 커밋하지 않습니다 (.gitignore 처리됨).
# 배포 시에는 이 값들을 Docker Compose environment / AWS Secrets Manager 로 주입합니다.

# 애플리케이션 설정
NODE_ENV=development
PORT=3000

# ===================================================================
# 데이터베이스 (PostgreSQL + pgvector)
# ===================================================================
# 로컬은 docker-compose 의 postgres 컨테이너(호스트 5433 포워딩)를 가리킵니다.
DATABASE_URL=postgresql://admin:password@localhost:5433/chatbot_db
# docker-compose.yml 이 POSTGRES_PASSWORD 로 참조 (DATABASE_URL 의 비밀번호와 일치시킬 것)
POSTGRES_PASSWORD=password

# ===================================================================
# JWT 인증
# ===================================================================
# 임의의 긴 랜덤 문자열로 교체 (예: `openssl rand -base64 48`)
JWT_SECRET=replace-with-a-long-random-secret
# 참고: 현재 코드는 access 15m / refresh 30d 를 하드코딩하고 있음.
#       아래 값을 실제로 사용하도록 연결하는 것은 리팩토링 TODO.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ===================================================================
# Telegram Bot
# ===================================================================
# @BotFather 에서 발급받은 토큰 (형식: 1234567890:AA...)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 봇 소유자의 앱 내 사용자 UUID (텔레그램 수신 메시지를 이 사용자에게 귀속시킴)
DEFAULT_USER_ID=your_app_user_uuid_here

# ===================================================================
# OpenAI API
# ===================================================================
# GPT 답변 생성에 사용. 본인 명의로 발급한 키 + usage limit 권장.
# (임베딩은 더 이상 OpenAI 를 쓰지 않음 — 아래 EMBEDDING_URL 참고)
OPENAI_API_KEY=sk-your-openai-api-key-here
# 채팅 모델명. 미설정 시 gpt-4o-mini. 모델이 retire 되면 이 값만 교체.
OPENAI_MODEL=gpt-4o-mini

# ===================================================================
# 임베딩 서비스 (apps/embedding, KoSimCSE 768차원)
# ===================================================================
# 로컬 단독 실행: docker run -p 8000:8000 likeme-embedding
# 루트 compose 편입 후에는 서비스명(예: http://embedding:8000)으로 변경.
EMBEDDING_URL=http://localhost:8000
