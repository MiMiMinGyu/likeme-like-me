# ==============================================================================
# 루트 docker-compose.yml 용 환경변수 템플릿
#   cp .env.example .env  후 실제 값 입력. .env 는 커밋 금지(.gitignore 처리됨).
#
# compose 가 이 값들을 ${VAR} 보간 + api 서비스 environment 로 주입한다.
# 비 Docker 로컬 실행(npm run start:dev)은 apps/api/.env 를 그대로 쓴다 — 별개 파일.
# ==============================================================================

# PostgreSQL 비밀번호 (db 서비스 + api 의 DATABASE_URL 에 함께 쓰임).
# @ : / 같은 특수문자를 쓰면 DATABASE_URL 에서 URL 인코딩 필요 — 영숫자 권장.
POSTGRES_PASSWORD=changeme

# JWT 서명 키 — 32자 이상 랜덤 문자열 (예: openssl rand -base64 48)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OpenAI 답변 생성. 본인 명의 키 권장.
OPENAI_API_KEY=sk-your-openai-api-key-here
# 채팅 모델명 (선택). 비우면 gpt-4o-mini. 모델 retire 시 이 값만 교체.
OPENAI_MODEL=gpt-4o-mini

# 텔레그램 봇 (선택). 안 쓰면 두 값 모두 비워둔다 — 봇만 비활성화되고 앱은 정상 부팅.
# 쓸 경우: TELEGRAM_BOT_TOKEN=@BotFather 토큰, DEFAULT_USER_ID=봇 소유자 앱 사용자 UUID(v4).
TELEGRAM_BOT_TOKEN=
DEFAULT_USER_ID=

# ── 웹(Caddy) 진입점 ──────────────────────────────────────────
# 로컬 데모는 비워두면 :80 평문 HTTP. AWS 배포 시 도메인을 넣으면
# Caddy 가 Let's Encrypt HTTPS 를 자동 발급한다 (예: likemelikeme.duckdns.org).
SITE_ADDRESS=
# 호스트 포트 매핑 (로컬에서 80/443 이 이미 점유됐을 때만 변경)
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
